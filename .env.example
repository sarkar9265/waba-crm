# ====================================================================
# Algo Matrix WABA CRM — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env, .env.production, or .env.staging to version control.
# ====================================================================

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waba?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Authentication ----
JWT_SECRET=your-secure-random-64-char-secret-here
JWT_EXPIRATION=7d

# ---- WhatsApp / Meta ----
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---- AI (Optional) ----
OPENAI_API_KEY=sk-xxxxx
GOOGLE_AI_KEY=your_google_ai_key

# ---- Storage ----
STORAGE_PROVIDER=LOCAL
# S3_BUCKET=your-bucket
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# CLOUDFLARE_R2_ACCOUNT_ID=your_account_id

# ---- Monitoring ----
SENTRY_DSN=
GRAFANA_PASSWORD=admin

# ---- CORS ----
CORS_ORIGIN=http://localhost:3002

# ---- Client App (NEXT_PUBLIC_ prefix required for browser access) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_CONFIG_ID=your_embedded_signup_config_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
NEXT_PUBLIC_STORAGE_URL=

# ---- Docker / Production ----
NODE_ENV=development
PORT=3001
