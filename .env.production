# WABA CRM Production Environment Variables
# Path: /.env.production (Rename to .env on the VPS, or load explicitly)

# -----------------------------------------------------------------------------
# CORE APP SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=production
# API Backend Port (Avoids conflict with 3000, 3001, etc.)

# Domains for CORS and Frontend communication
NEXT_PUBLIC_API_URL=https://api.algomatrixai.com
CORS_ORIGIN=https://app.algomatrixai.com,https://www.algomatrixai.com
NEXT_PUBLIC_APP_URL=https://app.algomatrixai.com

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL & Prisma)
# -----------------------------------------------------------------------------
# Replace 'user' and 'password' with your PostgreSQL credentials
DATABASE_URL="postgresql://user:password@localhost:5432/waba?schema=public"

# -----------------------------------------------------------------------------
# CACHE & QUEUES (Redis via BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# Generate a strong, random 64-character secret for production
JWT_SECRET="Rashi92!"
JWT_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# WHATSAPP CLOUD API (META)
# -----------------------------------------------------------------------------
# Obtain these from the Meta App Developer Console
META_APP_ID="2081734396063574"
META_APP_SECRET="ce59e047da8ae3fe5cd0055927f5d049"
META_WEBHOOK_VERIFY_TOKEN="algo_matrix_verify_token"
META_GRAPH_VERSION="v20.0"

# -----------------------------------------------------------------------------
# PAYMENT GATEWAYS (Razorpay / Paytm)
# -----------------------------------------------------------------------------
# Razorpay Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_Sm7GqBK0murDd2"
RAZORPAY_KEY_SECRET="I2Z2B5UeTnY8nlKWwUElBNR7"

# Paytm Credentials (if using Mock/Live Paytm)
PAYTM_MERCHANT_ID="YOUR_PAYTM_MID"
PAYTM_MERCHANT_KEY="YOUR_PAYTM_KEY"

# -----------------------------------------------------------------------------
# AI & INTEGRATIONS
# -----------------------------------------------------------------------------
# OpenAI for chatbot / Suggested Replies
OPENAI_API_KEY="sk-YOUR_OPENAI_API_KEY"

# Sentry (Optional for Error Tracking)
# SENTRY_DSN="https://your_sentry_dsn"
